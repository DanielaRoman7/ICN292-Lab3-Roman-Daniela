              "id": "682bcdb9-8ad0-4020-aa1b-369810f5129b",
              "name": "tasa_aprobacion",
              "value": "={{ (   Number(($json.resumen.find(r => r.ruta === 'APROBACION') || {}).count_id_solicitud || 0)   /   $json.resumen.reduce((total, r) => total + Number(r.count_id_solicitud), 0)   * 100 ).toFixed(2) }}",
              "type": "string"
            },
            {
              "id": "39b32ec8-a235-4b4e-a969-398b224165b2",
              "name": "mensaje",
              "value": "={{\n[\n  'RESUMEN DIARIO DE DEVOLUCIONES - ' + $now.setZone('America/Santiago').toFormat('dd-MM-yyyy'),\n  '',\n  'Total de solicitudes: ' + $json.resumen.reduce((t,r) => t + Number(r.count_id_solicitud),0),\n  'Monto total del día: $' + $json.resumen.reduce((t,r) => t + Number(r.sum_monto),0).toLocaleString('es-CL'),\n  '',\n  'Solicitudes por ruta:',\n  ...$json.resumen.map(r =>\n    r.ruta + ': ' +\n    r.count_id_solicitud +\n    ' solicitudes - $' +\n    Number(r.sum_monto).toLocaleString('es-CL')\n  ),\n  '',\n  'Tasa de aprobación automática: ' +\n  (\n    Number(($json.resumen.find(r => r.ruta === 'APROBACION') || {}).count_id_solicitud || 0)\n    /\n    $json.resumen.reduce((t,r) => t + Number(r.count_id_solicitud),0)\n    * 100\n  ).toFixed(2) + '%'\n].join('\\n')\n}}",
              "type": "string"
            }
          ]
        },
